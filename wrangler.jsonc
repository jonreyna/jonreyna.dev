// Cloudflare Workers Static Assets: the site is plain files, no Worker code.
// `make dist` stages ./dist; `make deploy` (or CI) uploads it.
{
  "name": "jonreyna-dev",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    // /resume serves resume/index.html; /resume/ redirects to /resume.
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page"
  },
  // The Worker is the origin for the bare domain; Cloudflare creates the DNS record and
  // the certificate. The deploy token needs Zone > Workers Routes > Edit on jonreyna.dev.
  // The zone's mail records (Proton) are untouched.
  "routes": [{ "pattern": "jonreyna.dev", "custom_domain": true }],
  "workers_dev": true,
  "preview_urls": true
}
