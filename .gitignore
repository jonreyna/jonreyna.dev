# Dart and Jaspr
.dart_tool/
/site/build/
# Fonts are downloaded and subset by `make fonts`; only their licenses are in git.
/site/web/fonts/*
!/site/web/fonts/*-OFL.txt
/site/web/fonts.css
# The résumé files are rendered by `make site-resume` from resume/resume.yaml.
/site/web/resume/
# The Open Graph image and the favicons are drawn by `make og-image` and `make favicon`
# (tools/card).
/site/web/og.png
/site/web/favicon.svg
/site/web/favicon.ico
/site/web/apple-touch-icon.png
# Go binaries that `go build` writes into a command's own folder.
/tools/vitae/vitae
/tools/vitae/cmd/vitae/vitae
/tools/card/card
/tools/card/cmd/card/card
/tools/card/cmd/icon/icon

# Deploy staging and Wrangler state
/dist/
/build/
.wrangler/

# Private résumé data never enters this repository
*.private.yaml
!*.private.example.yaml

.DS_Store
.idea/
*.iml

# Python bytecode from running the build scripts
__pycache__/
